# Copie para .env na VPS — NUNCA commite o .env real
# O install-vps.sh PERGUNTA o domínio e preenche estas três linhas por você.
# Se preencher à mão, use o SEU domínio (o que você apontou no DNS):
DOMAIN=
PUBLIC_URL=
RMM_SERVER_URL=
# Porta interna do app (atrás do proxy)
PORT=3000
# O install-vps.sh gera automaticamente com: openssl rand -hex 32
SESSION_SECRET=
