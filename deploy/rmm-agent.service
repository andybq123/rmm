[Unit]
Description=RMM Agent (Linux)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A URL vem de /opt/rmm-agent/agent.env. O script gerado pelo painel
# (aba Agentes) já nasce pré-configurado com o site; este arquivo de
# ambiente só é necessário se você sobrescrever o servidor:
#   RMM_SERVER_URL=https://<seu-dominio>/actions
EnvironmentFile=/opt/rmm-agent/agent.env
ExecStart=/usr/bin/env bash /opt/rmm-agent/rmm-agent-linux.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
